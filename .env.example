# Copy to .env and fill in. Values referenced from config YAML via ${VAR} interpolation.

# Redis (rate limiting / caching backends)
REDIS_URL=redis://localhost:6379

# Admin API bearer token (config: admin.token: ${ADMIN_TOKEN})
ADMIN_TOKEN=change-me

# Example tenant API key (config: auth.providers[].keys[].key: ${ACME_API_KEY})
ACME_API_KEY=change-me-too

# JWT auth — exactly one of JWKS or HMAC secret
# JWT_HMAC_SECRET=
# JWKS_URI=https://auth.example.com/.well-known/jwks.json

# OpenTelemetry OTLP endpoint (config: observability.tracing.otlpEndpoint)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
